# Server-only secrets. Never prefix these with VITE_ and never commit real values.
MEEVO_APP_ID=
MEEVO_APP_SECRET=

# Meevo supplies production Marketplace/Public API URLs with production credentials.
# Test Bed examples are documented at docs.meevoapi.com.
MEEVO_TOKEN_URL=https://d18devmarketplace.meevodev.com/oauth2/token
MEEVO_API_BASE_URL=https://d18devpub.meevodev.com/publicapi

# Browser origin allowed to call this API in production.
APP_ORIGIN=https://herlinm4-prog.github.io
PORT=8787
