{
  "manifest_version": 3,
  "name": "Next Walking Meevo Bridge",
  "version": "0.1.0",
  "description": "Read-only bridge for an already authenticated Meevo session.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://na0.meevo.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "Next Walking Bridge"},
  "content_scripts": [{"matches": ["https://na0.meevo.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}